<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.

  Adaptive icons are 108dp but launchers only guarantee the centre 72dp is
  visible, and they mask to circles, squircles and rounded squares alike. The
  mark is therefore built as a compact chip whose full extent stays inside a
  66dp circle centred at 54,54, so no launcher mask can clip it.

  The mark: a boot-image chip with gold contact pins along the top edge and a
  blue hex "nut" in the middle, which reads as hardware being tuned.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chip: 40x44, spanning x 34..74, y 32..76. -->
    <path
        android:pathData="M44,32 h20 a10,10 0 0,1 10,10 v24 a10,10 0 0,1 -10,10 h-20 a10,10 0 0,1 -10,-10 v-24 a10,10 0 0,1 10,-10 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="32"
                android:endX="74" android:endY="76"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFD5E1FB" />
        </aapt:attr>
    </path>

    <!-- Gold contact pins along the top edge. -->
    <path android:fillColor="#FFC8951C"
        android:pathData="M44,32 h5 v6 h-5 z M51.5,32 h5 v6 h-5 z M59,32 h5 v6 h-5 z" />

    <!-- Hex nut, centred on the chip. -->
    <path android:fillColor="#FF1B6BFF"
        android:pathData="M54,43 L62.5,47.8 L62.5,57.2 L54,62 L45.5,57.2 L45.5,47.8 Z" />

    <!-- Nut bore. -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,49.5 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />

    <!-- Board trace below the nut. -->
    <path android:strokeColor="#FF8FA9CF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M44,68 h20" />
</vector>